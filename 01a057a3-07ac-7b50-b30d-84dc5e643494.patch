+## CI workflow (paste into `.github/workflows/android.yml`)
+
+If adding a workflow, use this corrected version (includes a lint step):
+
+```yaml
+name: Android CI
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Build debug APK
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Set up Android SDK
+        run: |
+          SDKMGR="${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager"
+          if [ ! -x "$SDKMGR" ]; then SDKMGR="$(command -v sdkmanager)"; fi
+          echo "Using sdkmanager: $SDKMGR"
+          yes | "$SDKMGR" --licenses > /dev/null 2>&1 || true
+          "$SDKMGR" "platforms;android-33" "build-tools;33.0.0"
+
+      - name: Run unit tests
+        run: ./gradlew testDebugUnitTest --stacktrace --info --no-daemon --console=plain
+
+      - name: Run lint
+        run: ./gradlew lintDebug --stacktrace --no-daemon --console=plain
+
+      - name: Build debug APK
+        run: ./gradlew assembleDebug --stacktrace --info --no-daemon --console=plain
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: app-debug
+          path: app/build/outputs/apk/debug/*.apk
+          if-no-files-found: error
+
+      - name: Upload lint report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: lint-report
+          path: app/build/reports/lint-results-debug.html
+          if-no-files-found: ignore
+
+      - name: Upload Build and Test Logs for AI
+        uses: actions/upload-artifact@v4
+        if: always()
+        continue-on-error: true
+        with:
+          name: raw-build-logs
+          path: |
+            app/build/reports/
+            app/build/outputs/androidTest-results/
+```
+
+Note: SDK platform/bundle is `android-33` (matches `compileSdk = 33`), not 36.
+
