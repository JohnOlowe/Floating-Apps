<?xml version="1.0" encoding="utf-8"?>
<!--
    The window this is added to is given an explicit square size by the service, so the
    oval background renders as a true circle. Sizes are in dp, not sp: sp scales with the
    user's font setting, which would turn the circle into an ellipse.
-->
<RelativeLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="30dp"
     android:layout_width="30dp"
     android:background="@drawable/clicker_circle"
     android:id="@+id/coordinator">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_centerInParent="true"
         android:id="@+id/clickId"
         android:textSize="13sp"
         android:includeFontPadding="false"
         android:textColor="@android:color/white" />

</RelativeLayout>
